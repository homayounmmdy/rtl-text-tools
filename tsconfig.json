{
  "compilerOptions": {
    "target": "es5",
    "ignoreDeprecations": "5.0",
    "module": "commonjs",
    "lib": ["es5", "es2015.core", "es2015.iterable", "dom"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
