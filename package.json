{
  "name": "@homayounmmdy/rtl-text-tools",
  "version": "1.1.0",
  "description": "Cross-browser RTL text utility — fixes digits, punctuation, ellipsis, and bidi markers for Arabic, Hebrew, Persian, Urdu, and other RTL scripts. Supports IE11+.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "rtl",
    "arabic",
    "hebrew",
    "persian",
    "farsi",
    "urdu",
    "bidi",
    "unicode",
    "i18n",
    "l10n",
    "right-to-left",
    "cross-browser",
    "ie11",
    "digits",
    "punctuation"
  ],
  "author": {
    "name": "Homayoun Mohammadi",
    "email": "homayoun763@gmail.com",
    "url": "https://github.com/homayounmmdy"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/homayounmmdy/rtl-text-tools.git"
  },
  "bugs": {
    "url": "https://github.com/homayounmmdy/rtl-text-tools/issues"
  },
  "homepage": "https://github.com/homayounmmdy/rtl-text-tools#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "README.md",
    "LICENSE"
  ]
}
