{
  "name": "rtl-text-tools",
  "version": "1.2.0",
  "description": "Cross-browser RTL text utility — fixes digits, punctuation, ellipsis, and bidi markers for Arabic, Hebrew, Persian, Urdu, and other RTL scripts. Supports IE11+.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp-server.d.ts",
      "import": "./dist/mcp-server.js"
    }
  },
  "sideEffects": [
    "./dist/mcp-server.js"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "test": "npm run build && jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "rtl",
    "arabic",
    "hebrew",
    "persian",
    "farsi",
    "urdu",
    "kurdish",
    "pashto",
    "sindhi",
    "uyghur",
    "punjabi",
    "bidi",
    "unicode",
    "i18n",
    "l10n",
    "right-to-left",
    "cross-browser",
    "ie11",
    "digits",
    "punctuation",
    "normalization",
    "diacritics",
    "text-processing",
    "typescript",
    "quranic",
    "ellipsis"
  ],
  "author": {
    "name": "Homayoun Mohammadi",
    "email": "homayoun763@gmail.com",
    "url": "https://github.com/homayounmmdy"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/homayounmmdy/rtl-text-tools.git"
  },
  "bugs": {
    "url": "https://github.com/homayounmmdy/rtl-text-tools/issues"
  },
  "homepage": "https://github.com/homayounmmdy/rtl-text-tools#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "mcp-jest": "^1.2.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "rtl-text-tools-mcp": "./dist/bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  }
}
