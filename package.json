{
  "name": "rtl-text-tools",
  "version": "1.0.0",
  "description": "Cross-browser RTL text utility — fixes digits, punctuation, ellipsis, and bidi markers for Arabic, Hebrew, Persian, Urdu, and other RTL scripts. Supports IE11+.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepare": "npm run build"
  },
  "keywords": [
    "rtl",
    "arabic",
    "hebrew",
    "persian",
    "farsi",
    "urdu",
    "bidi",
    "unicode",
    "i18n",
    "l10n",
    "right-to-left",
    "cross-browser",
    "ie11",
    "digits",
    "punctuation"
  ],
  "author": {
    "name": "Homayoun Mohammadi",
    "email": "homayoun763@gmail.com",
    "url": "https://github.com/homayounmmdy"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homayounmmdy/rtl-text-tools.git"
  },
  "bugs": {
    "url": "https://github.com/homayounmmdy/rtl-text-tools/issues"
  },
  "homepage": "https://github.com/homayounmmdy/rtl-text-tools#readme",
  "devDependencies": {
    "@types/node": "^25.3.2",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ]
}